[Unit]
Description=clippo clipboard history daemon
Documentation=https://github.com/darthxvaderxd/clippo

# The daemon needs a Wayland session to bind data-control on, so it belongs to
# the COSMIC session rather than to the login: started with it, stopped with it.
# PartOf means logging out stops clippod instead of leaving a daemon holding an
# encrypted history open against a compositor that is gone.
After=cosmic-session.target
PartOf=cosmic-session.target

[Service]
# Type=exec rather than simple: systemd then reports a missing or unexecutable
# binary as a failed start instead of a start that succeeded and immediately
# died, which is the difference between `systemctl --user status clippod`
# naming the problem and it saying "activating".
Type=exec

# `just install` rewrites this line to the bindir it actually installed to.
# %h/.local/bin is the default user-local install, which needs no root.
ExecStart=%h/.local/bin/clippod

# DESIGN.md's risk table: the daemon owns the Wayland selection, so if it dies
# the clipboard empties. Restarting costs one clipboard's worth of content
# rather than the rest of the session. The history itself is on disk and is
# unaffected either way.
Restart=on-failure
RestartSec=2

# Set CLIPPO_LOG (falling back to RUST_LOG, default info) to change verbosity:
#   systemctl --user edit clippod
#   [Service]
#   Environment=CLIPPO_LOG=clippod=debug,clippo_wayland=debug
# Output goes to the journal: journalctl --user -u clippod -f

# clippo is unprivileged and never wants more than it starts with. The heavier
# sandboxing options are deliberately left off: the daemon needs the Wayland
# socket, the session bus, the Secret Service and its own data directory, and a
# namespace that broke any one of those would fail in a way that looks like a
# clippo bug rather than like a unit-file mistake.
NoNewPrivileges=true

[Install]
WantedBy=cosmic-session.target
